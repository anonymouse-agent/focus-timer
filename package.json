{
  "name": "focus-timer",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "A trustworthy, local-first Windows focus timer.",
  "license": "MIT",
  "author": "anonymouse-agent",
  "homepage": "https://github.com/anonymouse-agent/focus-timer",
  "repository": {
    "type": "git",
    "url": "https://github.com/anonymouse-agent/focus-timer.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "package:win": "npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "build": {
    "appId": "com.focustimer.desktop",
    "productName": "Focus Timer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "docs/RELEASE_NOTES.md",
        "to": "RELEASE_NOTES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "ASSET_LICENSE.md",
        "to": "ASSET_LICENSE.md"
      },
      {
        "from": "LICENSES/CC-BY-4.0.txt",
        "to": "LICENSES/CC-BY-4.0.txt"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Focus-Timer-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Focus Timer",
      "runAfterFinish": true,
      "artifactName": "Focus-Timer-Setup-${version}-windows-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
